{
    "name": "librecord-desktop",
    "productName": "Librecord",
    "version": "1.0.1",
    "repository": {
    "type": "git",
    "url": "https://github.com/libre-cord/libreapps.git"
  },
    "description": "Librecord for macOS, Windows and Linux",
    "author": "Librecord contributors",
    "homepage": "https://github.com/libre-cord",
    "license": "AGPL-3.0-only",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p . && tsc -p src/pages",
        "typecheck": "tsc -p . --noEmit && tsc -p src/pages --noEmit",
        "start": "bun run build && electron .",
        "dist": "bun run build && electron-builder"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.5"
    },

    "devDependencies": {
        "@types/node": "^24.10.1",
        "electron": "45.3.1",
        "electron-builder": "26.18.0",
        "typescript": "^5.9.3"
    },
    "trustedDependencies": ["electron"],
    "dependencies": {
        "arrpc": "^3.6.0"
    }
}
